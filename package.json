{
  "name": "opshaven",
  "version": "0.1.0",
  "description": "Safe, structured VPS inspection and controlled operations over restricted SSH for MCP clients.",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "opshaven": "dist/cli.js",
    "opshaven-mcp": "dist/index.js",
    "opshaven-dispatch": "dist/dispatcher/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "rm -rf dist .test-dist coverage",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/tests/**/*.test.js",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "start": "node dist/index.js",
    "test:integration": "sh integration/run.sh",
    "test:security": "npm run test:compile && node --test .test-dist/tests/adversarial.test.js .test-dist/tests/approval.test.js .test-dist/tests/redaction.test.js .test-dist/tests/ssh.test.js",
    "security:scan": "node scripts/security-scan.mjs",
    "security": "npm run test:security && npm run security:scan && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}

FROM node:22-bookworm-slim
WORKDIR /src
COPY package.json package-lock.json tsconfig.json tsconfig.build.json tsconfig.readonly.json ./
COPY types ./types
COPY src ./src
COPY tests ./tests
COPY scripts/ensure-bin-executable.mjs ./scripts/ensure-bin-executable.mjs
COPY integration/remote-mcp-podman ./integration/remote-mcp-podman
RUN npm ci --ignore-scripts --no-audit --no-fund \
  && npm run build \
  && chown -R node:node /src
USER node
ENV NODE_ENV=test
CMD ["node", "integration/remote-mcp-podman/interop.mjs"]

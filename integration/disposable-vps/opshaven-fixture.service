[Unit]
Description=OpsHaven disposable deployment fixture
After=network.target

[Service]
Type=simple
User=opshaven
Group=opshaven
WorkingDirectory=/srv/opshaven/current
ExecStart=/usr/bin/python3 /usr/local/bin/opshaven-fixture-server.py
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/opshaven

[Install]
WantedBy=multi-user.target
